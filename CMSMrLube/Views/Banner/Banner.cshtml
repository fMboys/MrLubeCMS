            $("#publish").prop("disabled", true);
        }

        function publishEnableButton() {
            $("#publish").prop("disabled", false);
        }

        function BannerEdit(id) {
            var url = "/Banner/Edit/?id=" + id;
            $.ajax({
                type: "Get",
                url: url,
                success: function(data) {
