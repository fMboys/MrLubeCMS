    <script type="text/javascript">

        //function btnPublish() {

        //    var url = "/Home/Publish;
        //    $.ajax({
        //        type: "Get",
        //        url: url,
        //        data: { img: @ViewBag.img}
        //                        success: function(data) {

        //                                },
        //        error: function(exp) {
        //            alert(exp.responseText);
        //        }
        //    });
        //}

        function saveBanner() {

            var formData = new FormData($('#bannerupload')[0]);
            var url = $('#bannerupload').attr('action');
            $.ajax({
                type: "Get",
                url: url,
                type: "POST",
                data: formData,
                async: false,
                success: function(data) {
                    if (data != null) {
                        if (data.isSuccessfull) {
                            toastr.success(data.message);
                        }
                        else {
                            toastr.error(data.message);
                        }
                    }
                    else {
                        // $("#dvErrorAuth").html("FE: Something went wrong");
                    }
                },
                error: function(exp) {
                    alert(exp.responseText);
                },
                cache: false,
                contentType: false,
                processData: false
            });
        }
    </script>
    }
