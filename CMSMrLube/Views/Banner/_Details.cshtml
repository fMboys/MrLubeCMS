@model CMS.Core.Entities.banners;
@using static IWebHostEnvironment;
@inject IConfiguration _configuration;
@{
    var AzureBlob = _configuration.GetSection("AzureBlob").Value;
    var bannerpath = "/img/banners/";
    //var img = TempData["mainimg"];
    //Layout = null;
    var serverTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
    string date = Model.date_created.Value.ToString("yyyy MM dd HH:mm:ss");
    DateTime dt = DateTime.ParseExact(date,"yyyy MM dd HH:mm:ss",System.Globalization.CultureInfo.CreateSpecificCulture("en-pk"));
    DateTime dt1 = TimeZone.CurrentTimeZone.ToLocalTime(Model.date_created.Value).ToUniversalTime();
    string dFormat = dt1.ToString("dd MMM yyyy HH:mm:ss");
    TimeZoneInfo tzi = TimeZoneInfo.FindSystemTimeZoneById("Pakistan Standard Time");
}
@*<link rel="stylesheet" href="~/css/toastr.css">*@
@*<link rel="stylesheet" href="~/css/custom.css">
<link rel="stylesheet" href="~/css/main.8d288f825d8dffbbe55e.css">*@
<div class="modal-dialog modal-lg" @*style="max-width: 1208px !important"*@>
    <div class="modal-content">

        <div class="modal-header">
            <h5 class="modal-title" id="bannerModalLabel">Home Page Banner @ViewBag.Title</h5>
            <button id="bannerModalbutton" data-dismiss="modal" type="button" class="close" aria-label="Close" aria-hidden="true" onclick="closeModal();">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            @*<div class="col-md-12">*@
            <div class="row" style="border-bottom: 1px solid grey;">
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; "><i class="fas fa-id-badge" style="width:20%;"></i><span style=width:25%>Home Banner ID:</span></label>
                @*<div class="col-md-2">
                <p><strong>Home Page Banner image:</strong> </p>
                </div>*@
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; ">@Model.banner_id</label>
                <label for="@Model.image" class="col-lg-2" style="word-wrap: break-word; margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; "></label>
                @{
                                                @if (@Model.view == "desktop")
                    {
                        var img = AzureBlob + bannerpath + @Model.image;
                                <div class="col-lg-4" style="display:block; text-align:center;background-color: #f8f9fa;">
                                                    <img src="@Url.Content(img)" style="height:90px; width:100%; padding-top: 0px; padding-left: 0px; background-color: #f8f9fa;" asp-append-version="true" />
                                </div>
                    }

                    else
                    {
                        var img = AzureBlob + bannerpath + @Model.image;
                            <div class="col-lg-4" style="display:block; text-align:center;background-color: #f8f9fa;">
                                                    <img src="@Url.Content(img)" style="height:95%; width:80%;padding-top: 0px; padding-left: 0px; background-color: #f8f9fa;" asp-append-version="true" />
                            </div>
                    }

                }
            </div>

            <div class="row">
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-language" style="width:20%;"></i><span style=width:25%>Language:</span></label>
                @{
                        if (@Model.language_id == 1)
                        {
                                                        <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">English</label>
                        }
                        else
                        {
                                                        <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">French</label>
                        }
                    }
                
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-pen" style="width:20%;"></i><span style=width:25%>Title:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="word-wrap: break-word; margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.title</label>
            </div>
            <div class="row">
                
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #e8e6e3; border-bottom: 1px solid grey;"><i class="fas fa-file-image" style="width:20%;"></i><span style=width:25%>Image Name:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="word-wrap: break-word; margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.image</label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-info" style="width:20%;"></i><span style=width:25%>Image Status:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.status</label>
            </div>

            <div class="row">
                
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-tablet" style="width:20%;"></i><span style=width:25%>View Device:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.view</label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-user" style="width:20%;"></i><span style=width:25%>Last User:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.last_user</label>
            </div>
            <div class="row" style="border-bottom: 1px solid grey;">
                
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #e8e6e3;"><i class="fas fa-link" style="width:20%;"></i><span style=width:25%>HyperLink</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="word-wrap: break-word; margin-bottom: 0px; font-weight:500; background-color: #f8f9fa;">@Model.ad_hyperlink</label>
                <label class="col-lg-3 pt-3 pb-2" style="font-weight:600;margin-bottom:0px; padding-left: 15px; background-color: #e8e6e3;"><i class="fa fa-calendar" style="width:20%;"></i><span style=width:25%>Created Date:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="font-weight:500;margin-bottom:0px; background-color: #f8f9fa; ">@TimeZoneInfo.ConvertTimeToUtc(Model.date_created.Value,serverTimeZone).ToString("dd MMM yyyy HH:mm:ss")</label>
            </div>
            <div class="row" style="border-bottom: 1px solid grey;">
                
                <label class="col-lg-3 pt-3 pb-2" style="font-weight:600;margin-bottom:0px; padding-left: 15px; background-color: #e8e6e3;"><i class="fa fa-calendar" style="width:20%;"></i><span style=width:25%>Update Date:</span></label>
                <label class="col-lg-9 pt-3 pb-2" style="font-weight:500;margin-bottom:0px; background-color: #f8f9fa; ">@TimeZoneInfo.ConvertTimeToUtc(Model.date_updated.Value,serverTimeZone).ToString("dd MMM yyyy HH:mm:ss")</label>
            </div>

            @* </div>*@

        </div>
        @*<div class="modal-footer2">
            <div style="">
                <button id="closeModeldown" type="button" class="btn btn-secondary" data-dismiss="modal" onclick="closeModal();">Close</button>


            </div>

            <div style="display: block;margin-left: auto;">

            <button id="publish" type="button" class="btn btn-primary" name="publish" value="submit" onclick=btnPublish();>Publish</button>
            </div>
        </div>*@

    </div>
</div>

