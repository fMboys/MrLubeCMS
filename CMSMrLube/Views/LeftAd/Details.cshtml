@using System.Text.RegularExpressions
@using MrLubeCMS.ViewModels;
@inject IConfiguration _configuration;
@model VMLeftAd;
@{
    var AzureBlob = _configuration.GetSection("AzureBlob").Value;
    var bannerpath = "/img/ads/";
    ViewBag.Title = "View";
    var leftAdPages = ViewBag.LeftAdPages;
    Layout = null;
    var serverTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
    DateTime dt1 = TimeZone.CurrentTimeZone.ToLocalTime(Model.LeftAdDto.CreatedDate.Value);
    string dFormat = dt1.ToString("dd MMM yyyy HH:mm:ss");
}

<div class="modal-dialog modal-lg">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title" id="modalCMSLabel">Left Ad Image Details</h4>
            <button id="btnCloseDetail" data-dismiss="modal" type="button" class="close" aria-label="Close" aria-hidden="true" onclick="closeModal();">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <ul class="nav nav-tabs nav-fill" style="font-size:17px">
                <li class="tabs active"><a data-toggle="tab" class="active nav-link" href="#tabDetail"> <i class="fa fa-user"></i> Details</a></li>
                <li class="tabs"><a data-toggle="tab" class="nav-link" href="#tabPage"><i class="fa fa-clipboard"></i> Pages</a></li>
            </ul>
            <div class="tab-content" style=" margin-top:14px">
                <div id="tabDetail" class="tab-pane active">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row" style="border-bottom: 1px solid grey;">
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#f8f9fa;"><i class="fas fa-id-badge" style="width:20%;"></i><span style="width:25%;">GUID:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500;">@Model.LeftAdDto.guid</label>
                                <label for="@Model.LeftAdDto.ImageName" class="col-lg-2 pt-3" style="word-wrap: break-word; background-color:#f8f9fa; margin-bottom: 0px; font-weight:500;"></label>
                                @{
                                    @if (@Model.LeftAdDto.ViewDevice == "desktop")
                                    {
                                        var img = AzureBlob + bannerpath + @Model.LeftAdDto.ImageName;
                                        <div class="col-md-4" style="display:block; text-align:center;background-color: #f8f9fa;">
                                            <img src="@Url.Content(img)" style="height:95%; width:70%; padding-top: 0px; padding-left: 0px; background-color: #f8f9fa; border-bottom: " asp-append-version="true" />
                                        </div>
                                    }
                                    else
                                    {
                                        var img = AzureBlob + bannerpath + @Model.LeftAdDto.ImageName;
                                        <div class="col-md-4" style="display:block; text-align:center;background-color: #f8f9fa;">
                                            <img src="@Url.Content(img)" style="height:95%; width:80%; padding-top: 0px; padding-left: 0px; background-color: #f8f9fa; " asp-append-version="true" />
                                        </div>
                                    }
                                }
                                @*<img src="@Url.Content("~/" + @Model.LeftAdDto.ImageName)" class="col-md-4" height="80" width="140" style="padding-top: 0px; padding-left: 0px; border-bottom: 1px solid grey;" asp-append-version="true" />*@
                            </div>

                            <div class="row">
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-language" style="width:20%;"></i><span style="width:25%;">Language:</span></label>
                                @{
                                    if (Model.LeftAdDto.LanguageId == 1)
                                    {
                                        <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">English</label>
                                    }
                                    else if (Model.LeftAdDto.LanguageId == 2)
                                    {
                                        <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">French</label>
                                    }
                                }

                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-pen" style="width:20%;"></i><span style="width:25%;">Title:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="word-wrap: break-word; margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.Title</label>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #f8f9fa; border-bottom: 1px solid grey;"><i class="fas fa-file-image" style="width:20%;"></i><span style="width:25%;">Image Name:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="word-wrap: break-word; margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.ImageName</label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-file" style="width:20%;"></i><span style="width:25%;">Page Type:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.ViewPage</label>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-user" style="width:20%;"></i><span style="width:25%;">Last User:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.LastUser</label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #f8f9fa; border-bottom: 1px solid grey;"><i class="fas fa-info" style="width:20%;"></i><span style="width:25%;">Image Status</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.ImageStatus</label>
                            </div>
                            <div class="row">
                                @*<label class="col-lg-2 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-file" style="padding-right:5px;"></i>Page:</label>
                                <label class="col-lg-4 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.UrlKey</label>*@
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-tablet" style="width:20%;"></i><span style="width:25%;">View Device:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.ViewDevice</label>
                                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #f8f9fa; border-bottom: 1px solid grey;"><i class="fas fa-link" style="width:20%;"></i><span style="width:25%;">HyperLink</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="word-wrap: break-word; margin-bottom: 0px; font-weight:500; border-bottom: 1px solid grey;">@Model.LeftAdDto.Hyperlink</label>
                            </div>
                            @*<div class="row">
                                
                            </div>*@
                            <div class="row">
                                <label class="col-lg-3 pt-3 pb-2" style="font-weight:600; padding-left: 15px; background-color:#f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-calendar" style="width:20%;"></i><span style="width:25%;">Created Date:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="font-weight:500; border-bottom: 1px solid grey;">@TimeZoneInfo.ConvertTimeToUtc(Model.LeftAdDto.CreatedDate.Value,serverTimeZone).ToString("dd MMM yyyy HH:mm:ss")</label>
                                <label class="col-lg-3 pt-3 pb-2" style="font-weight:600; padding-left: 15px; background-color: #f8f9fa; border-bottom: 1px solid grey;"><i class="fa fa-calendar" style="width:20%;"></i><span style="width:25%;">Update Date:</span></label>
                                <label class="col-lg-3 pt-3 pb-2" style="font-weight:500; border-bottom: 1px solid grey;">@TimeZoneInfo.ConvertTimeToUtc(Model.LeftAdDto.UpdatedDate.Value,serverTimeZone).ToString("dd MMM yyyy HH:mm:ss")</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tabPage" class="tab-pane">
                    <input asp-for="@Model.LeftAdDto.selectedPages" type="hidden" id="selectedPages" name="selectedPages" class="form-control-file" value="@Model.LeftAdDto.selectedPages" />
                    <div class="row">
                        <div class="col-lg-12">
                            <fieldset>
                                <legend>Pages</legend>
                                <div id="listPages" class="col-md-12 checkbox-group required">
                                    <label id="lblCbxValidate"></label>
                                    @{
                                        foreach (var item in Model.SubMenus)
                                        {
                                            if (ViewBag.LeftAdPages != null)
                                            {
                                                string reg = @Regex.Replace(item.title, @"\s+", "");

                                                <div class="col-md-6">
                                                    @{
                                                        string isActive = "";
                                                        foreach (var check in ViewBag.LeftAdPages)
                                                        {
                                                            if (@item.url_key == check.url_key)
                                                            {
                                                                isActive = "disabled";
                                                            }
                                                        }
                                                        if (isActive == "disabled")
                                                        {
                                                            <input id="cbxPage" type="checkbox" class="cbxMark" disabled="@isActive" name="@reg" value="@item.sub_menu_id" />
                                                            <label for="@reg">@item.title</label>
                                                        }
                                                    }

                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </fieldset>

                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

</div>