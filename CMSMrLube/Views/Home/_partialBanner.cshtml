<div class="modal-dialog" role="document">
    <div class="modal-content">
        <form asp-action="Banner" class="" id="bannerupload" method="post" enctype="multipart/form-data">
            <div class="modal-header">
                <h5 class="modal-title" id="bannerModalLabel">Banner Image Uploading</h5>
                <button id="bannerModalbutton" data-dismiss="modal" type="button" class="close" aria-label="Close" aria-hidden="true" onclick="closeModal();">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="position-relative form-group">
                    <label for="bannerFile" class="">Upload Banner Image File</label>
                    <input type="file" accept="image/png,image/jpg" name="imgfile" id="imgfile" class="form-control-file">
                    <small class="form-text text-muted">Please Upload the Home Page Banner Image File with Size 700 * 350 Pixel.</small>

                </div>
                <div class="col-md-12">
                    <div class="position-relative form-group">
                        <label for="BannerTitle" class="">Banner Title</label>
                        <input name="BannerTitle" id="BannerTitle" placeholder="Banner Title" type="text" class="form-control">

                    </div>
                </div>
                <div class="col-md-12">
                    <div class="position-relative form-group">
                        <label for="Hyperlink" class="">Hyper link for Image</label>
                        <input name="Hyperlink" id="Hyperlink" placeholder="Hyperlink" type="text" class="form-control">

                    </div>
                </div>
                <div class="col-md-12">
                    <div class="position-relative form-group">
                        <label for="statusSelect" class="">Select Status</label>
                        <select name="Status" id="statusSelect" class="form-control">
                            <option>active</option>
                            <option>inactive</option>

                        </select>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="position-relative form-group">
                        <label for="viewSelect" class="">Select View</label>
                        <select name="viewSelect" id="viewSelect" class="form-control">
                            <option>Desktop</option>
                            <option>Mobile</option>

                        </select>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="position-relative form-group">
                        <label for="languageSelect" class="">Select Language</label>
                        <select name="language" id="languageSelect" class="form-control">
                            <option>English</option>
                            <option>French</option>

                        </select>
                    </div>
                </div>

            </div>
            <div class="modal-footer2">
                <div style="">
                    <button id="closeModeldown" type="button" class="btn btn-secondary" data-dismiss="modal" onclick="closeModal();">Close</button>
                    <button id="SaveBanner" type="button" class="btn btn-primary" name="bannerupload" value="submit" onclick="saveBanner();">Save & Preview</button>
                </div>

                <div style="display: block;margin-left: auto;">
                    <button id="publish" type="button" class="btn btn-primary" name="publish" value="submit" onclick="btnPublish();">Publish</button>
                </div>

            </div>
        </form>
    </div>
</div>

