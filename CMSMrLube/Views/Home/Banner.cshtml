        function btnPublish() {

            var url = "/Home/Publish";
            var img = "@ViewBag.image";
            $.ajax({
                type: "Post",
                url: url,
                data: img,
                success: function(data) {
        @*var hostName = window.location.origin;
                    hostName += "/@selecteLang/locations/Search";
                    window.location.href = hostName;*@
                                                                                                    },
                error: function(exp) {
                    alert(exp.responseText);
                }
            });
        }

        function NewBanner() {
            var url = "/Home/Create";
            $.ajax({
                type: "Get",
                url: url,
                success: function(data) {
                    $.fn.modal.Constructor.prototype.enforceFocus = function() { };
                    $('#bannermoadal').html(data);
                    $('#bannermoadal').modal('show');
                    //mask();
                    //$('select').each(function () {
                    //    if ($(this).hasClass('js-source-states')) {
                    //        $(this).select2();
                    //    }
                    //});
                    //ValidateRules();
                }
            });
        }

        function saveBanner() {

            var formData = new FormData($('#bannerupload')[0]);
            var url = $('#bannerupload').attr('action');
            $.ajax({
                type: "Post",
                url: url,
                data: formData,
                success: function(data) {
                    if (data != null) {
                        if (data.isSuccessfull) {
                            toastr.success(data.message);
                        }
                        else {
                            toastr.error(data.message);
                        }
                    }
                    else {
                        // $("#dvErrorAuth").html("FE: Something went wrong");
                    }
                },
                error: function(exp) {
                    alert(exp.responseText);
                },
                cache: false,
                contentType: false,
                processData: false
            });
        }

        function closeModal() {
            $('#bannermoadal').modal('hide');
        }


