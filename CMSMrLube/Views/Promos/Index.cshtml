@{
    ViewData["Title"] = "Promo Pages";

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<link rel="stylesheet" href="/resources/demos/style.css">*@
 
<h1>@ViewData["Title"]</h1>
<div class="card mb-3">
    <div class="text-center d-block p-3 card-footer">
        <button type="button" name="AddPromo" class="btn-pill btn-shadow btn-wide fsize-1 btn btn-primary btn-lg" onclick="AddNewItem()">
            <span class="mr-2 opacity-7">
                <i class="fa fa-plus"></i>
            </span>
            <span class="mr-1">Add New Promo</span>
        </button>
    </div>
    <div class="card-body">
        <table id="tblPromo" style="width:100%;overflow-wrap:anywhere;" class="table table-hover table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th style="width: 20%">Item Id#</th>
                    <th style="width: 20%">English Title</th>
                    <th style="width: 20%">French Title</th>
                    <th style="width: 20%">Status</th>
                    <th style="width: 20%">Action</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>
    </div>
</div>
 

<script src="~/assets/js/jquery-3.3.1.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script> 
<script src="~/assets/scripts/Promos.js"></script>
