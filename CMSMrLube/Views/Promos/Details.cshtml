@model CMS.Core.DTOs.PromoPagesDto
@{
    ViewBag.Title = "View";
    Layout = null;
    var serverTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
}

<div class="modal-dialog modal-lg">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title" id="modalCMSLabel">Promo Details</h4>
            <button id="btnCloseDetail" data-dismiss="modal" type="button" class="close" aria-label="Close" aria-hidden="true" onclick="closeModal();">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">

            <div class="row">
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fas fa-id-badge" style="width:20%;"></i><span style=width:25%>Item ID:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.ItemId</label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-language" style="width:20%;"></i><span style=width:25%>English Title:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey; overflow-wrap:break-word;">@Model.Title</label>
            </div>

            <div class="row">
                
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color: #e8e6e3; border-bottom: 1px solid grey;"><i class="fas fa-store" style="width:20%;"></i><span style=width:25%>French Title:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.frenchTitle</label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-info" style="width:20%;"></i><span style=width:25%>Date Expired:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.date_expired</label>
            </div>
            <div class="row">
               
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-info" style="width:20%;"></i><span style=width:25%>Status:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.status</label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:600; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-user" style="width:20%;"></i><span style=width:25%>Last User:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="margin-bottom: 0px; font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@Model.LastUser</label>
            </div>
            @*<div class="row">
                
            </div>*@
            <div class="row">
                <label class="col-lg-3 pt-3 pb-2" style="font-weight:600; padding-left: 10px; background-color:#e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-calendar" style="width:20%;"></i><span style=width:25%>Created Date:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@TimeZoneInfo.ConvertTimeToUtc(Model.CreatedDate.Value,serverTimeZone).ToString("dd MMM yyyy HH:mm:ss")</label>
                <label class="col-lg-3 pt-3 pb-2" style="font-weight:600; padding-left: 10px; background-color: #e8e6e3; border-bottom: 1px solid grey;"><i class="fa fa-calendar" style="width:20%;"></i><span style=width:25%>Update Date:</span></label>
                <label class="col-lg-3 pt-3 pb-2" style="font-weight:500; background-color: #f8f9fa; border-bottom: 1px solid grey;">@TimeZoneInfo.ConvertTimeToUtc(Model.UpdatedDate.Value,serverTimeZone).ToString("dd MMM yyyy HH:mm:ss")</label>
            </div>
        </div>
    </div>
</div>