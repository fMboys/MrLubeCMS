                @{
                    @if (@Model.ViewDevice == "desktop")
                    {
                        var img = AzureBlob + bannerpath + @Model.ImageName;
                        <div class="col-md-4" style="display:block; text-align:center;background-color: #f8f9fa;">
                            <img src="@Url.Content(img)" style="height:55px; width:100%; padding-top: 0px; padding-left: 0px; background-color: #f8f9fa; border-bottom: " asp-append-version="true" />
                        </div>
                    }
                    else
                    {
                        var img = AzureBlob + bannerpath + @Model.ImageName;
                        <div class="col-md-4" style="display:block; text-align:center;background-color: #f8f9fa;">
                            <img src="@Url.Content(img)" style="height:95%; width:80%; padding-top: 0px; padding-left: 0px; background-color: #f8f9fa; " asp-append-version="true" />
                        </div>
                    }
                }
                @*<img src="@Url.Content("~/" + @Model.ImageName)" class="col-md-4" height="80" width="140" style="padding-top: 0px; padding-left: 0px; background-color: #f8f9fa; border-bottom: 1px solid grey;" asp-append-version="true" />*@
