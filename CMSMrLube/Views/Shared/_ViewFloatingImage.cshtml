@using MrLubeCMS.ViewModels
@using System.Text.RegularExpressions
@inject IConfiguration _configuration;
@*@inject CMS.Core.Interfaces.IApplicationRepository _appRepo;*@
@model ViewModelFloatingImage;
@using static IWebHostEnvironment
@{
    var AzureBlob = _configuration.GetSection("AzureBlob").Value;
    var bannerpath = "/img/floating/";
    var image = TempData["mainImage"];
    var selectedPages = Model.SubMenus;
    var checkedPages = ViewBag.checkedPages;
    var floatingImagePages = ViewBag.FloatingImagePages;
    var mwidth = ViewBag.mwidth;
    var mheight = ViewBag.mheight;
    var dwidth = ViewBag.dwidth;
    var dheight = ViewBag.dheight;
    //ViewBag.ImageSpecs = _appRepo.GetAllImagesSpecifications();

    //var specs = ViewBag.ImageSpecs;
    Layout = null;
}

<div class="modal-dialog" role="document">

    <div class="modal-content">
        <form asp-action="SaveFloatingImage" id="formFloatingImage" method="post" enctype="multipart/form-data">
            <div class="modal-header">

                @if (ViewBag.Title == "Edit")
                {
                    <h5 class="modal-title" id="modalCMSLabel">Edit Floating Image Details</h5>
                }
                else
                {
                    <h5 class="modal-title" id="modalCMSLabel">Add Floating Image Details</h5>
                }

                @*<button type="button" class="close" data-bs-dismiss="modal" aria-hidden="true" onclick="closeModal();">&times;</button>*@
                <button type="button" class="close" data-bs-dismiss="modal" aria-hidden="true" onclick="closeModal();">&times;</button>
            </div>

            <div class="modal-body">
                @{
                    <input id="hdnStaggingDomain" type="hidden" value="@_configuration["StagingDomain"]" />
                    <input id="hdnProdDomain" type="hidden" value="@_configuration["ProdDomain"]" />
                }
                <ul class="nav nav-tabs nav-fill" style="font-size:17px">
                    <li class="tabs active"><a data-toggle="tab" class="active nav-link" href="#tabDetail"> <i class="fa fa-user"></i> Details</a></li>
                    @{

                        var engpage = "English Pages";
                        var frpage = "French Pages";
                        if (ViewBag.Title == "Create")
                        {
                            @if (ViewBag.lang == 1)
                            {
                                <li class="tabs"><a data-toggle="tab" class="nav-link" href="#tabPage"><i class="fa fa-clipboard"></i> @engpage </a></li>
                            }
                            else if (ViewBag.lang == 2)
                            {
                                <li class="tabs"><a data-toggle="tab" class="nav-link" href="#tabPage"><i class="fa fa-clipboard"></i> @frpage </a></li>
                            }
                        }
                        else if (ViewBag.Title == "Edit")
                        {
                            @if (Model.FloatingImageDto.LanguageId == 1)
                            {
                                <li class="tabs"><a data-toggle="tab" class="nav-link" href="#tabPage"><i class="fa fa-clipboard"></i> @engpage </a></li>
                            }
                            else if (Model.FloatingImageDto.LanguageId == 2)
                            {
                                <li class="tabs"><a data-toggle="tab" class="nav-link" href="#tabPage"><i class="fa fa-clipboard"></i> @frpage </a></li>
                            }
                        }

                    }

                </ul>
                <div class="tab-content" style=" margin-top:14px">
                    <div id="tabDetail" class="tab-pane active">
                        <div class="row">
                            <div class="col-lg-12">
                                <fieldset>
                                    <div class="row">
                                        <div class="form-group col-md-6">
                                            <div class="position-relative form-group">
                                                <label asp-for="@Model.FloatingImageDto.ViewDevice" class="form-label mb-1 text-2">Select View Device</label>
                                                <select asp-for="@Model.FloatingImageDto.ViewDevice" name="viewDevice" id="viewDevice" class="form-control" readonly onchange="toggleHintText();">
                                                    @{
                                                        if (ViewBag.Title == "Edit")
                                                        {
                                                            if (Model.FloatingImageDto.ViewDevice == "desktop")
                                                            {
                                                                <option selected>Desktop</option>
                                                                //<option>Mobile</option>
                                                            }
                                                            else if (Model.FloatingImageDto.ViewDevice == "mobile")
                                                            {
                                                                <option selected>Mobile</option>
                                                                //<option>Desktop</option>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (ViewBag.views == "desktop")
                                                            {
                                                                <option selected>Desktop</option>
                                                            }
                                                            else if (ViewBag.views == "mobile")
                                                            {
                                                                <option selected>Mobile</option>
                                                            }

                                                        }
                                                    }
                                                    @*<option>Desktop</option>
                                                    <option>Mobile</option>*@
                                                </select>
                                            </div>
                                        </div>
                                        <div class="position-relative form-group col-md-6">

                                            <label for="FloatingImageFile">Upload Floating Image File</label>
                                            <div class="col-sm-8">
                                                <input asp-for="@Model.FloatingImageDto.ImageName" type="file" accept="*/*" name="imageFile" id="imageFile" class="form-control-file" value="" onchange="validateFileResolution(this,event);" onclick="FileOnClick(event);" />
                                            </div>
                                            @{
                                                if (ViewBag.Title == "Edit")
                                                {
                                                    @if (Model.FloatingImageDto.ViewDevice == "desktop")
                                                    {
                                                        <small class="form-text text-muted" id="txtImageHint">Please select an image of Resolution @dwidth px x @dheight px.</small>
                                                    }
                                                    else if (Model.FloatingImageDto.ViewDevice == "mobile")
                                                    {
                                                        <small class="form-text text-muted" id="txtImageHint">Please select an image of Resolution @mwidth px x @mheight px.</small>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (ViewBag.views == "desktop")
                                                    {
                                                        <small class="form-text text-muted" id="txtImageHint">Please select an image of Resolution @dwidth px x @dheight px.</small>
                                                    }
                                                    else if (ViewBag.views == "mobile")
                                                    {
                                                        <small class="form-text text-muted" id="txtImageHint">Please select an image of Resolution @mwidth px x @mheight px.</small>
                                                    }
                                                }
                                                
                                            }
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            @{
                                                if (Model.FloatingImageDto.ImageName != null)
                                                {
                                                    if (@Model.FloatingImageDto.ViewDevice == "desktop")
                                                    {
                                                        <div style="display:block; margin-bottom:5px;text-align:center;">
                                                            <img src="@Url.Content(AzureBlob + bannerpath + @Model.FloatingImageDto.ImageName)" class="" style="height:45%; width:60%;" asp-append-version="true" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div style="display:block; margin-bottom:5px;text-align:center;">
                                                            <img src="@Url.Content(AzureBlob + bannerpath + @Model.FloatingImageDto.ImageName)" class="" style="height:45%; width:100%;" asp-append-version="true" />
                                                        </div>
                                                    }
                                                }
                                                        //if (@Model.FloatingImageDto.ImageName != null)
                                                //{

                                                //    <img src="@Url.Content("~/" + @Model.FloatingImageDto.ImageName)" class="rounded-circle" height="80" width="140" asp-append-version="true" />

                                                //}

                                            }
                                        </div>
                                        <div class="col-md-6">
                                            @{
                                                if (ViewBag.Title == "Edit")
                                                {
                                                    <label for="@Model.FloatingImageDto.ImageName" style="margin-left: 10px; ">@Model.FloatingImageDto.ImageName</label>


                                                }
                                            }
                                            <input for="@ViewBag.Title" type="hidden" id="formMode" name="formMode" class="form-control-file" value="@ViewBag.Title" />
                                            <input for="@Model.FloatingImageDto.ImageName" type="hidden" id="imageUpload" name="imageUpload" class="form-control-file" value="@Model.FloatingImageDto.ImageName" />
                                            <input asp-for="@Model.FloatingImageDto.Id" type="hidden" id="floatingImageID" name="floatingImageID" class="form-control-file" value="@Model.FloatingImageDto.Id" />
                                            <input asp-for="@Model.FloatingImageDto.guid" type="hidden" id="floatingImageGUID" name="floatingImageGUID" class="form-control-file" value="@Model.FloatingImageDto.guid" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group col-md-6">
                                            <label asp-for="@Model.FloatingImageDto.Title" class="form-label mb-1 text-3">Title</label>
                                            <div class="position-relative">
                                                <i class="fa fa-pen text-color-primary text-3 position-absolute" style="padding: 12px 5px 0px 10px;"></i>
                                                <input asp-for="@Model.FloatingImageDto.Title" name="titleImage" id="titleImage" placeholder="Title" type="text" class="form-control" style="padding-left:45px;" aria-describedby="titleImage-error" />
                                                <em id="titleImage-error" class="error invalid-feedback">Enter Title for Image.</em>
                                            </div>
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label asp-for="@Model.FloatingImageDto.Hyperlink" class="form-label mb-1 text-2">Image HyperLink</label>
                                            <div class="position-relative">
                                                <i class="fas fa-link text-color-primary text-3 position-absolute" style="padding: 12px 5px 0px 10px;"></i>
                                                <input asp-for="@Model.FloatingImageDto.Hyperlink" name="imageHyperLink" id="imageHyperLink" placeholder="HyperLink" type="text" class="form-control" style="padding-left:45px;" aria-describedby="imageHyperLinkError" />
                                                <em id="imageHyperLinkError" class="error invalid-feedback">Enter hyperlink for image.</em>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group col-md-6">
                                            <div class="position-relative form-group">
                                                <label asp-for="@Model.FloatingImageDto.ImageStatus" class="form-label mb-1 text-2">Select Status</label>
                                                <select asp-for="@Model.FloatingImageDto.ImageStatus" name="imageStatus" id="imageStatus" class="form-control" onchange="checkActiveImagePages()">
                                                    <option>Active</option>
                                                    <option>Inactive</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group col-md-6">
                                            <div class="position-relative form-group">
                                                <label asp-for="@Model.FloatingImageDto.LanguageId" class="form-label mb-1 text-2">Choose your preferred language</label>
                                                <select asp-for="@Model.FloatingImageDto.LanguageId" name="language" id="language" class="form-control" readonly>
                                                    @{
                                                        if (Model.FloatingImageDto.LanguageId != 0)
                                                        {
                                                            if (Model.FloatingImageDto.LanguageId == 1)
                                                            {
                                                                <option selected>English</option>
                                                                //<option>French</option>
                                                            }
                                                            else if (Model.FloatingImageDto.LanguageId == 2)
                                                            {
                                                                <option selected>French</option>
                                                                //<option>English</option>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (ViewBag.lang == 1)
                                                            {
                                                                <option selected>English</option>
                                                            }
                                                            else if (ViewBag.lang == 2)
                                                            {
                                                                <option selected>French</option>
                                                            }

                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <!--Tab Page-->

                    <div id="tabPage" class="tab-pane">
                        @*@Html.HiddenFor(x => x.FloatingImageDto.selectedPages)*@
                        <input asp-for="@Model.FloatingImageDto.selectedPages" type="hidden" id="selectedPages" name="selectedPages" class="form-control-file" value="@Model.FloatingImageDto.selectedPages" />
                        <div class="row">
                            <div class="col-lg-12">
                                <fieldset>
                                    @{

                                        var eng = "English Pages";
                                        var fr = "French Pages";
                                        if (ViewBag.Title == "Create")
                                        {
                                            @if (ViewBag.lang == 1)
                                            {
                                                <legend>@eng</legend>
                                            }
                                            else if (ViewBag.lang == 2)
                                            {
                                                <legend>@fr</legend>
                                            }

                                        }
                                        else if (ViewBag.Title == "Edit")
                                        {
                                            @if (Model.FloatingImageDto.LanguageId == 1)
                                            {
                                                <legend>@eng</legend>
                                            }
                                            else if (Model.FloatingImageDto.LanguageId == 2)
                                            {
                                                <legend>@fr</legend>
                                            }
                                        }

                                    }

                                    <input type="checkbox" id="selectAll" name="text" onchange="toggleAll(this);" />
                                    <label>Select All</label>
                                    <div id="listPages" class="row col-md-12 checkbox-group required">
                                        <label id="lblCbxValidate"></label>
                                        @{
                                            foreach (var item in Model.SubMenus)
                                            {
                                                if (ViewBag.Title == "Create")
                                                {
                                                    if (ViewBag.floatingImagePages != null)
                                                    {
                                                        string reg = @Regex.Replace(item.title, @"\s+", "");

                                                        <div class="col-md-6">
                                                            @{
                                                                string isActive = "";
                                                                foreach (var check in ViewBag.floatingImagePages)
                                                                {
                                                                    if (@item.url_key == check.url_key)
                                                                    {
                                                                        isActive = "disabled";
                                                                    }
                                                                }
                                                                if (isActive == "disabled")
                                                                {
                                                                    <input id="cbxPage" type="checkbox" class="cbxMark" disabled="@isActive" name="@reg" value="@item.sub_menu_id" />
                                                                    <label for="@reg">@item.title</label>
                                                                }
                                                                else
                                                                {
                                                                    <input id="cbxPage" type="checkbox" class="cbxMark" onchange="syncSelectAll();" name="@reg" value="@item.sub_menu_id">
                                                                    <label for="@reg">@item.title</label>
                                                                }
                                                            }

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        string reg = @Regex.Replace(@item.title, @"\s+", "");

                                                        <div class="col-md-6">
                                                            <input id="cbxPage" type="checkbox" class="cbxMark" onchange="syncSelectAll();" name="@reg" value="@item.sub_menu_id">
                                                            <label for="@reg">@item.title</label>
                                                        </div>
                                                    }
                                                }
                                                else if (ViewBag.Title == "Edit")
                                                {
                                                    if (ViewBag.checkedPages != null && floatingImagePages != null)
                                                    {
                                                        string reg = @Regex.Replace(item.title, @"\s+", "");

                                                        <div class="col-md-6">
                                                            @{
                                                                string isChecked = "";
                                                                string isActive = "";

                                                                foreach (var page in floatingImagePages)
                                                                {
                                                                    if (@item.url_key == page.url_key)
                                                                    {
                                                                        isActive = "disabled";
                                                                    }
                                                                }
                                                                foreach (var check in ViewBag.checkedPages)
                                                                {
                                                                    if (Convert.ToBoolean(@item.sub_menu_id == check.sub_menu_id))
                                                                    {
                                                                        isChecked = "checked";
                                                                    }
                                                                }
                                                                if (isChecked == "checked")
                                                                {
                                                                    <input id="cbxPage" type="checkbox" class="cbxMark" checked="@isChecked" onchange="syncSelectAll();" name="@reg" value="@item.sub_menu_id" />
                                                                    <label for="@reg">@item.title</label>
                                                                }
                                                                else if (isActive == "disabled")
                                                                {
                                                                    <input id="cbxPage" type="checkbox" class="cbxMark" disabled="@isActive" name="@reg" value="@item.sub_menu_id" />
                                                                    <label for="@reg">@item.title</label>
                                                                }
                                                                else
                                                                {
                                                                    <input id="cbxPage" type="checkbox" class="cbxMark" onchange="syncSelectAll();" name="@reg" value="@item.sub_menu_id">
                                                                    <label for="@reg">@item.title</label>
                                                                }
                                                            }

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        string reg = @Regex.Replace(@item.title, @"\s+", "");

                                                        <div class="col-md-6">
                                                            <input id="cbxPage" type="checkbox" class="cbxMark" onchange="syncSelectAll();" name="@reg" value="@item.sub_menu_id">
                                                            <label for="@reg">@item.title</label>
                                                        </div>
                                                    }
                                                }

                                            }
                                        }
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <div>
                    <button id="btnCloseModel" type="button" class="btn btn-warning" onclick="closeModal();">Close</button>
                    @{
                        if (ViewBag.Title == "Edit")
                        {
                            <button id="btnUpdate" type="button" class="btn btn-primary" name="submit" value="submit" onclick="updateFloatingImage();">Update & Preview</button>
                        }
                        else
                        {
                            <button id="btnSave" type="button" class="btn btn-success" name="submit" value="submit" onclick="saveFloatingImage()">Save & Preview</button>
                        }
                    }
                </div>
                <div style="display: block; margin-left: auto;">
                    <button id="btnPublish" type="button" class="btn btn-info" name="submit" value="submit" onclick="publishFloatingImage();">Publish</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
    var formModeCheck = '@ViewBag.Title';
    var mwidthSize = '@mwidth';
    var mheightSize = '@mheight';
    var dwidthSize = '@dwidth';
    var dheightSize = '@dheight';
</script>

