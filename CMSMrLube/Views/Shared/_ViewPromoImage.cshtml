@model CMS.Core.Entities.PromoImages;
@using static IWebHostEnvironment;
@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration;
@{
    var AzureBlob = Configuration.GetSection("AzureBlob").Value;
    var bannerpath = "/img/promos/";
    var image = TempData["mainImage"];

    var mwidth = ViewBag.mwidth;
    var mheight = ViewBag.mheight;
    var dwidth = ViewBag.dwidth;
    var dheight = ViewBag.dheight;
    Layout = null;
}
@{
    List<CMS.Core.Entities.PromoPages> ddlPromoPages = ViewBag.ddlPromoPages as List<CMS.Core.Entities.PromoPages>;
}
<div class="modal-dialog" role="document">
    <div class="modal-content">
        <form asp-action="SavePromoImage" id="formPromoImage" method="post" enctype="multipart/form-data">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCMSLabel">@ViewBag.Title Promo Image</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-hidden="true" onclick="closeModal();">&times;</button>
            </div>
            <div class="modal-body">
                @{
                    <input id="hdnStaggingDomain" type="hidden" value="@Configuration["StagingDomain"]" />
                    <input id="hdnProdDomain" type="hidden" value="@Configuration["ProdDomain"]" />
                }
                <div class="row">

                    <div class="form-group col-md-6">
                        <div class="position-relative form-group">
                            <label asp-for="@Model.view" class="form-label mb-1 text-2">Select View Device</label>
                            @{
                                if (ViewBag.Title == "Edit")
                                {
                                    <select asp-for="@Model.view" name="viewDevice" id="viewDevice" class="form-control" readonly onchange="toggleHintText();">
                                        <option selected>@Model.view</option>
                                        @*<option>Mobile</option>*@
                                    </select>
                                }
                                else
                                {
                                    <select asp-for="@Model.view" name="viewDevice" id="viewDevice" class="form-control" onchange="toggleHintText();">
                                        <option>Desktop</option>
                                        <option>Mobile</option>
                                    </select>
                                }
                            }

                        </div>
                    </div>
                    <div class="position-relative form-group col-md-6">
                        <label for="PromoImageFile">Upload Promo Image Image File</label>
                        <input asp-for="@Model.image" type="file" accept="*/*" name="imageFile" id="imageFile" class="form-control-file" value="" onchange="validateFileResolution(this,event);" onclick="FileOnClick(event);" />

                        @{
                            if (Model.view == "desktop")
                            {
                                <small class="form-text text-muted" id="txtImageHint">Please select an image of Resolution @dwidth px x @dheight px.</small>
                            }
                            else if (Model.view == "mobile")
                            {
                                <small class="form-text text-muted" id="txtImageHint">Please select an image of Resolution @mwidth px x @mheight px.</small>
                            }
                            else
                            {
                                <small class="form-text text-muted" id="txtImageHint">Please select an image of Resolution @dwidth px x @dheight px.</small>
                            }
                        }

                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        @{
                            @if (@Model.image != null)
                            {
                                if (@Model.view == "desktop")
                                {
                                    <div style="display:block; margin-bottom:5px;text-align:center;">
                                        <img src="@Url.Content(AzureBlob + bannerpath + @Model.image)" class="" style="height:30%; width:95%;" asp-append-version="true" />
                                    </div>
                                }
                                else
                                {
                                    <div style="display:block; margin-bottom:5px;text-align:center;">
                                        <img src="@Url.Content(AzureBlob + bannerpath + @Model.image)" class="" style="height:90%; width:30%;" asp-append-version="true" />
                                    </div>
                                }

                            }
                        }
                    </div>

                    <div class="col-md-6">
                        @{
                            if (ViewBag.Title == "Edit")
                            {
                                <label for="@Model.image" style="margin-left: 10px; ">@Model.image</label>
                                //<input for="@Model.image" type="text" name="imageFileName" class="form-control" value="@Model.image" disabled style="margin-top: 5px; margin-bottom: 5px;" />
                            }

                            <input for="@ViewBag.Title" type="hidden" id="formMode" name="formMode" class="form-control-file" value="@ViewBag.Title" />
                            <input for="@Model.image" type="hidden" id="imageUpload" name="imageUpload" class="form-control-file" value="@Model.image" />
                            <input asp-for="@Model.promo_image_id" type="hidden" id="promo_image_id" name="promo_image_id" class="form-control-file" value="@Model.promo_image_id" />
                            <input asp-for="@Model.guid" type="hidden" id="guid" name="guid" class="form-control-file" value="@Model.guid" />
                        }
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <label asp-for="@Model.title" class="form-label mb-1 text-3">Title</label>
                        <div class="position-relative">
                            <i class="fa fa-pen text-color-primary text-3 position-absolute" style="padding: 12px 5px 0px 10px;"></i>
                            @*@Html.TextBoxFor(x => x.title, new { @class="form-control text-3 h-auto px-5"})*@
                            <input asp-for="@Model.title" name="title" id="title" placeholder="Title" type="text" class="form-control" style="padding-left:45px;" aria-describedby="title-error" />
                            @*<span asp-validation-for="@Model.title" class="text-danger"></span>*@
                            <em id="title-error" class="error invalid-feedback">Please enter Title.</em>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        <div class="position-relative form-group">
                            <label asp-for="@Model.url_key" class="form-label mb-1 text-2">Select Promo Page</label>
                            <select onchange="titleOnChange();" asp-for="@Model.url_key" name="url_key" id="url_key" class="form-control">
                                @{
                                    //if (ddlPromoPages != null && ddlPromoPages.Count() > 0)
                                    //{
                                        <option value="">--Select--</option>
                                        @foreach (var item in ddlPromoPages)
                                        {
                                            <option value="@item.url_Key">@item.title</option>
                                        }
                                    //}
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <label asp-for="@Model.promo_hyperlink" class="form-label mb-1 text-2">Image HyperLink</label>
                        <div class="position-relative">
                            <i class="fas fa-link text-color-primary text-3 position-absolute" style="padding: 12px 5px 0px 10px;"></i>
                            <input asp-for="@Model.promo_hyperlink" name="imageHyperLink" id="imageHyperLink" placeholder="HyperLink" type="text" class="form-control" style="padding-left:45px;" aria-describedby="imageHyperLinkError" />
                            @*<span asp-validation-for="@Model.promo_hyperlink" class="text-danger"></span>*@
                            <em id="imageHyperLinkError" class="error invalid-feedback">Enter hyperlink for image.</em>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <div class="position-relative form-group">
                            <label asp-for="@Model.status" class="form-label mb-1 text-2">Select Status</label>
                            <select asp-for="@Model.status" name="imageStatus" id="imageStatus" class="form-control">
                                <option>Active</option>
                                <option>Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        <div class="position-relative form-group">
                            <label asp-for="@Model.language_id" class="form-label mb-1 text-2">Choose your preferred language</label>
                            <select asp-for="@Model.language_id" name="language" id="language" class="form-control" onchange="titleOnChange()">
                                @{
                                    if (Model.language_id != 0)
                                    {
                                        if (Model.language_id == 1)
                                        {
                                            <option selected>English</option>
                                            <option>French</option>
                                        }
                                        else if (Model.language_id == 2)
                                        {
                                            <option selected>French</option>
                                            <option>English</option>
                                        }
                                    }
                                    else
                                    {
                                        <option>English</option>
                                        <option>French</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row" id="dvPromoUrls">
                    <div class="form-group col-md-6">
                        <label class="form-label mb-1 text-3">Staging url</label>
                        <div class="position-relative">
                            <a id="dvStagingPromoUrl" target="_blank" href="" style="cursor:pointer"></a>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        <label class="form-label mb-1 text-3">Production url</label>
                        <div class="position-relative">
                            <a id="dvProductionPromoUrl" target="_blank" href="" style="cursor:pointer"></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div>
                    <button id="btnCloseModel" type="button" class="btn btn-warning" onclick="closeModal();">Close</button>
                    @{
                        if (ViewBag.Title == "Edit")
                        {
                            <button id="btnUpdate" type="button" class="btn btn-primary" name="submit" value="submit" onclick="updatePromoImage();">Update & Preview</button>
                        }
                        else
                        {
                            <button id="btnSave" type="button" class="btn btn-success" name="submit" value="submit" onclick="savePromoImage()">Save & Preview</button>
                        }
                    }
                </div>
                <div style="display: block; margin-left: auto;">
                    <button id="btnPublish" type="button" class="btn btn-info" name="submit" value="submit" onclick="publishPromoImage();">Publish</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script>var formModeCheck = '@ViewBag.Title';
    var mwidthSize = '@mwidth';
    var mheightSize = '@mheight';
    var dwidthSize = '@dwidth';
    var dheightSize = '@dheight';
</script>